{
  "checks": [
    {
      "name": "Security Scan",
      "command": "python scripts/guardian.py --level security",
      "timeout": 60,
      "enabled": true
    },
    {
      "name": "Code Audit",
      "command": "python scripts/audit_agent.py --mode shadow",
      "timeout": 120,
      "enabled": true
    },
    {
      "name": "Unit Tests",
      "command": "python scripts/test_runner.py --output json",
      "timeout": 300,
      "enabled": true
    }
  ]
}
