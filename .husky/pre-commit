#!/bin/sh

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "Running hooks..."
cd "$PROJECT_ROOT" && PYTHONPATH="$PROJECT_ROOT" python .vibe-coding-workflow/hooks/runner.py --hook-type pre_commit
HOOK_EXIT=$?

if [ $HOOK_EXIT -ne 0 ]; then
    echo "Hook validation failed. Please fix the issues above."
    exit 1
fi

echo "All hooks passed"
exit 0
