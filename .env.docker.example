# Environment variables for OpenCode Docker sandbox
# Copy this file to .env.docker and fill in your API keys
# DO NOT commit .env.docker to git (it's in .gitignore)

# Non-interactive mode settings
CI=true
DEBIAN_FRONTEND=noninteractive
GIT_TERMINAL_PROMPT=0
PIP_NO_INPUT=1

# API Keys - fill in at least one
MINIMAX_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
